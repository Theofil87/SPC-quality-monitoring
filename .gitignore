# Generated dataset (reproducible via src/data_generation/generate_data.py)
data/raw/*.csv

# Python bytecode / cache
__pycache__/
*.py[cod]
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# Packaging / tooling caches
*.egg-info/
.mypy_cache/
.ruff_cache/

# dbt build artifacts and local profiles (profiles may contain credentials)
target/
dbt_packages/
logs/
profiles.yml

# Local database backups
*.dump
*.sql.gz
*.backup
*.bak
backups/

# Local secrets and private configuration
.env
.env.*
!.env.example
.streamlit/secrets.toml
.pgpass
pgpass.conf
credentials.json
credentials.local.*
*.pem
*.key
