# Copy outside the repository as ~/.dbt/profiles.yml, or point DBT_PROFILES_DIR
# to a local, ignored directory. Do not put a password in this repository.
spc_quality_monitoring:
  target: dev
  outputs:
    dev:
      type: postgres
      host: "{{ env_var('PGHOST', 'localhost') }}"
      port: "{{ env_var('PGPORT', '5432') | int }}"
      user: "{{ env_var('PGUSER', 'postgres') }}"
      password: "{{ env_var('PGPASSWORD') }}"
      dbname: "{{ env_var('PGDATABASE', 'spc_quality_monitoring') }}"
      schema: analytics
      threads: 4
